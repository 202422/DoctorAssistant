# ==============================================================================
# Doctor Assistant - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ==============================================================================

# ==== LLM Provider ====
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1/

# ==== Smithery MCP - Neon PostgreSQL ====
# Get your API key from https://smithery.ai/
NEON_SMITHERY_API_KEY=your-smithery-api-key-here
NEON_SMITHERY_MCP_URL=https://api.smithery.ai/connect/your-project/neon/mcp

# ==== Smithery MCP - Google Maps ====
MAP_SMITHERY_API_KEY=your-smithery-api-key-here
MAP_SMITHERY_MCP_URL=https://api.smithery.ai/connect/your-project/google-maps/mcp

# ==== LangSmith Tracing (Optional) ====
# Get your API key from https://smith.langchain.com/
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=langsmith project name
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ==== Neon Database ====
# Get your connection string from https://neon.tech/
NEON_PROJECT_ID=your-neon-project-id
NEON_BRANCH_ID=your-neon-branch-id
NEON_DATABASE_NAME=neondb
NEON_DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require
